{
  "openapi": "3.1.0",
  "info": {
    "title": "Cursiv Robotics Bridge",
    "version": "1.0.0",
    "description": "Loopback ingestion API for signed robot observations. Version 1 paths are stable; breaking changes get /v2. The service never commands robots."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8750"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required when the service was started with --token-file (always, for non-loopback binds)."
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "payload",
          "payloadType",
          "signatures"
        ],
        "description": "DSSE envelope (secure-systems-lab/dsse). Signature over PAE(payloadType, base64-decoded payload).",
        "properties": {
          "payload": {
            "type": "string",
            "description": "Base64 of the exact JSON body (cursiv-record-1 or cursiv-checkpoint-1)"
          },
          "payloadType": {
            "type": "string",
            "enum": [
              "application/vnd.cursiv.record.v1+json",
              "application/vnd.cursiv.checkpoint.v1+json"
            ]
          },
          "signatures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "keyid",
                "sig"
              ],
              "properties": {
                "keyid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "sig": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "duplicate",
              "rejected"
            ]
          },
          "robot_id": {
            "type": "string"
          },
          "seq": {
            "type": "integer"
          },
          "record_hash": {
            "type": "string"
          },
          "missing_attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "expected_seq": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "security": [],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Service is running"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Robots, record counts, heads and missions",
        "responses": {
          "200": {
            "description": "Status"
          }
        }
      }
    },
    "/v1/robots/{robot_id}/head": {
      "get": {
        "summary": "Records received from a robot and the head hash (to resume after a disconnection)",
        "parameters": [
          {
            "name": "robot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9._-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Head"
          }
        }
      }
    },
    "/v1/observations": {
      "post": {
        "summary": "Submit one signed record, or a batch {\"records\": [...]} of up to 1000",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Envelope"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "records": {
                        "type": "array",
                        "maxItems": 1000,
                        "items": {
                          "$ref": "#/components/schemas/Envelope"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accepted"
          },
          "200": {
            "description": "Duplicate: identical record already stored (idempotent retry)"
          },
          "207": {
            "description": "Batch: per-record results"
          },
          "400": {
            "description": "Malformed or bad signature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Key not trusted for this robot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Gap, chain mismatch, equivocation or duplicate observation id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Observation fails structural validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Queue full: retry after Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/checkpoints": {
      "post": {
        "summary": "Submit a robot-signed checkpoint (count, head, Merkle root)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Envelope"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored"
          },
          "409": {
            "description": "Disagrees with received records (equivocation)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/attachments/{sha256}": {
      "put": {
        "summary": "Upload raw evidence; bytes must hash to sha256 and match Content-Length",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {}
          }
        },
        "responses": {
          "201": {
            "description": "Stored"
          },
          "200": {
            "description": "Already present"
          },
          "400": {
            "description": "Hash/length mismatch or interrupted transfer; nothing kept",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Is an attachment present",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Present"
          },
          "404": {
            "description": "Absent"
          }
        }
      }
    },
    "/v1/exports": {
      "post": {
        "summary": "Write a station-signed evidence package (a BagIt bag) under <store>/exports/<name>",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]{1,64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Exported"
          },
          "409": {
            "description": "Name exists or export failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "Verify an exported package by name with the service's trust store (same code as cursiv-verify)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification report"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1"
          }
        }
      }
    }
  }
}
